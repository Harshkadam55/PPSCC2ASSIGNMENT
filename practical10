#include <stdio.h>

// Returns 1 if leap year, 0 otherwise
int isLeapYear(int year) {
    return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
}

// Sakamoto's algorithm: returns 0 = Sun, 1 = Mon, ..., 6 = Sat
int getFirstDayOfYear(int year) {
    int y = year - 1;
    return (y + y / 4 - y / 100 + y / 400 + 1) % 7;
}

int main() {
    int year;
    printf("Enter a year: ");
    if (scanf("%d", &year) != 1 || year < 1) {
        printf("Invalid year.\n");
        return 1;
    }

    const char *months[] = {
        "January", "February", "March", "April",
        "May", "June", "July", "August",
        "September", "October", "November", "December"
    };

    int daysInMonth[] = {
        31, 28, 31, 30, 31, 30,
        31, 31, 30, 31, 30, 31
    };

    if (isLeapYear(year)) {
        daysInMonth[1] = 29;
    }

    int startDay = getFirstDayOfYear(year);

    printf("\n========== CALENDAR - %d ==========\n", year);

    for (int m = 0; m < 12; m++) {
        printf("\n  ------------ %s ------------\n", months[m]);
        printf("  Sun  Mon  Tue  Wed  Thu  Fri  Sat\n");

        // Print leading spaces for the first day of the month
        for (int s = 0; s < startDay; s++) {
            printf("     ");
        }

        // Print all days of the month
        for (int day = 1; day <= daysInMonth[m]; day++) {
            printf("%5d", day);
            if ((startDay + day) % 7 == 0) {
                printf("\n");
            }
        }

        // Move to a new line if the month didn't end on Saturday
        if ((startDay + daysInMonth[m]) % 7 != 0) {
            printf("\n");
        }

        // Update starting weekday for the next month
        startDay = (startDay + daysInMonth[m]) % 7;
    }

    return 0;
}
